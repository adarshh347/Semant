    ],
    "model_expectation": {
      "checkpoint": "facebook/sam3",
      "preprocessing_version": "sam3-pcs-v1",
      "conf": 0.25,
      "imgsz": 1024,
      "max_instances": 16
    },
    "warm_or_cold": "warm",
    "repeat_count": 3,
    "reproducibility": {
      "seed": null,
      "deterministic_framer": false,
      "note": "No planner runs in this mode, so there is no phrase stability to measure here. Phrase stability needs repeated PLANNER calls, which would break the one-call discipline that makes Arm C readable \u2014 `compare` answers it across separate orchestrated runs instead.\n"
    },
    "expected_condition": "positive",
    "review": {
      "protocol": "human_visual",
      "gold_mask_path": null,
      "questions": [
        "Were the mask hashes identical across all three runs?",
        "If not, how far apart were the instance counts \u2014 and does any comparison in this lab survive that?"
      ]
    },
