{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semant/research/rehearsals/vertical/vertical-summary.schema.json",
  "title": "Vertical rehearsal summary (ATLAS-WRITER-MASS-BUILD-001L)",
  "description": "The machine-readable audit one run of scripts/vertical_rehearsal.py leaves behind. Every assertion names its evidence; a stage that could not run says why and which lane brings the seam it needs.",
  "type": "object",
  "required": ["harness", "run_id", "mode", "profile", "base", "stack", "stages", "assertions", "gate", "hashes", "evidence"],
  "properties": {
    "harness": {"const": "ATLAS-WRITER-MASS-BUILD-001L"},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["offline", "live"]},
    "profile": {"enum": ["default", "real-photo"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "base": {
      "type": "object",
      "required": ["commit", "branch"],
      "properties": {"commit": {"type": "string"}, "branch": {"type": "string"}, "dirty": {"type": "boolean"}}
    },
    "provider_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seam", "mode"],
        "properties": {"seam": {"type": "string"}, "mode": {"enum": ["fake", "live", "unavailable"]}}
      }
    },
    "stack": {
      "type": "object",
      "required": ["fakes", "boot_seconds", "backend_restarts"],
      "properties": {
        "fakes": {"enum": ["all", "ml_only", "none"]},
        "boot_seconds": {"type": "object"},
        "backend_restarts": {"type": "integer", "minimum": 0},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "ms"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pass", "fail", "unavailable", "skipped", "error"]},
          "detail": {"type": "string"},
          "lane": {"type": ["string", "null"]},
          "ms": {"type": "number", "minimum": 0},
          "evidence": {"type": "object"},
          "screenshots": {"type": "array", "items": {"type": "string"}},
          "mutations": {"type": "array"}
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "detail", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]+$"},
          "title": {"type": "string"},
          "status": {"enum": ["pass", "fail", "unavailable"]},
          "detail": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "lane": {"type": ["string", "null"]}
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["status", "failed_stages", "unavailable_stages", "lanes_preventing_full_pass"],
      "properties": {
        "status": {"enum": ["pass", "blocked", "fail"]},
        "failed_stages": {"type": "array", "items": {"type": "string"}},
        "unavailable_stages": {"type": "array", "items": {"type": "string"}},
        "lanes_preventing_full_pass": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hashes": {
      "type": "object",
      "required": ["before", "after", "changed"],
      "properties": {
        "before": {"type": "object"},
        "after": {"type": "object"},
        "changed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["ids", "receipts", "refusals", "operations", "hash_timeline", "expected_writes", "unexpected", "screenshots", "timings"],
      "properties": {
        "unexpected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["post_id", "stage", "diff"],
            "properties": {"diff": {"type": "array"}}
          }
        }
      }
    },
    "preserved": {"type": "object"}
  }
}
