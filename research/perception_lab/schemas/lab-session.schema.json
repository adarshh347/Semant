{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semant:perception-lab/lab-session.schema.json",
  "$defs": {
    "InstanceRef": {
      "additionalProperties": false,
      "description": "One instance inside one artifact, as a session records having selected it.\n\nBOTH FIELDS ARE REQUIRED, and that is the whole design. \"Never store a bare instance_id\" is a\nrule nobody has to remember when there is no arrangement of this record that could hold one:\nan instance id is unique inside its artifact and nowhere else, so `inst_1` on its own names\nevery extent set's first mask at once. A flat list of instance ids would be ambiguous in the\nNORMAL case rather than an exotic one, because every set numbers its own from 1.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "instance_id": {
          "minLength": 1,
          "title": "Instance Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "instance_id"
      ],
      "title": "InstanceRef",
      "type": "object"
    },
    "LabSource": {
      "additionalProperties": false,
      "description": "What is being looked at, and the digest that proves it did not move underneath the run.",
      "properties": {
        "origin": {
          "enum": [
            "upload",
            "post",
            "fixture"
          ],
          "title": "Origin",
          "type": "string"
        },
        "post_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Id"
        },
        "image_digest": {
          "minLength": 8,
          "title": "Image Digest",
          "type": "string"
        },
        "natural_width": {
          "exclusiveMinimum": 0,
          "title": "Natural Width",
          "type": "integer"
        },
        "natural_height": {
          "exclusiveMinimum": 0,
          "title": "Natural Height",
          "type": "integer"
        }
      },
      "required": [
        "origin",
        "image_digest",
        "natural_width",
        "natural_height"
      ],
      "title": "LabSource",
      "type": "object"
    },
    "OrganFamily": {
      "description": "The eight perceptual questions. Six are registered and disabled.",
      "enum": [
        "extent",
        "topology",
        "colour",
        "illumination",
        "surface_pattern",
        "orientation_flow",
        "depth",
        "surface_form"
      ],
      "title": "OrganFamily",
      "type": "string"
    },
    "PromptTurn": {
      "additionalProperties": false,
      "description": "What the person said, and which plan it became. Never what the machine 'understood'.",
      "properties": {
        "turn_id": {
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        }
      },
      "required": [
        "turn_id",
        "text",
        "at"
      ],
      "title": "PromptTurn",
      "type": "object"
    },
    "SessionMode": {
      "enum": [
        "isolation",
        "chain"
      ],
      "title": "SessionMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One sitting at the laboratory.\n\nTHE FOLLOW-UP LAW LIVES HERE. \"that mask\" is resolvable only through `active_artifact_id`,\n`active_region_ids`, `selected_artifact_ids` and `selected_instance_refs`. There is\ndeliberately no field in which a planner could record what it thinks the person meant, because\na remembered intention is indistinguishable from an invented identity the moment it is wrong.\n\n`selected_instance_refs` IS PAIRS, NOT IDS, and that is the whole reason it is a record type.\nA list of bare instance ids would be ambiguous the moment two selected artifacts each held an\n`inst_1` \u2014 which is every time, since each extent set numbers its own from 1. It is also why\nan instance ref may not name an artifact this session has not selected: a reference reachable\nfrom one field and invisible in the other is how a deselection gets disobeyed.",
  "properties": {
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/LabSource"
    },
    "selected_organ": {
      "$ref": "#/$defs/OrganFamily"
    },
    "mode": {
      "$ref": "#/$defs/SessionMode"
    },
    "active_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Artifact Id"
    },
    "active_region_ids": {
      "items": {
        "type": "string"
      },
      "title": "Active Region Ids",
      "type": "array"
    },
    "selected_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Selected Artifact Ids",
      "type": "array"
    },
    "selected_instance_refs": {
      "items": {
        "$ref": "#/$defs/InstanceRef"
      },
      "title": "Selected Instance Refs",
      "type": "array"
    },
    "prompt_turns": {
      "items": {
        "$ref": "#/$defs/PromptTurn"
      },
      "title": "Prompt Turns",
      "type": "array"
    },
    "run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Run Ids",
      "type": "array"
    },
    "review_ids": {
      "items": {
        "type": "string"
      },
      "title": "Review Ids",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "source",
    "selected_organ",
    "mode",
    "created_at",
    "updated_at"
  ],
  "title": "LabSession",
  "type": "object"
}
