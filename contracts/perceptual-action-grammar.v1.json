{
  "schema_version": "perceptual-action-grammar.v1",
  "title": "The Perceptual Action Grammar",
  "what_this_is": [
    "Semant's public law for 'a thing a curator might do next in the image-writing circuit'.",
    "It is DATA, not code, because two runtimes now enforce it: the Differential frontend (CIRCUIT-001 P2B)",
    "and the backend inquiry mind (HARNESS-001A). A vocabulary that lives in one language is a vocabulary",
    "the other language is free to paraphrase, and a paraphrased action name is a hallucination that merely",
    "looks like a typo.",
    "Behaviour — normalisation, labels, warnings, UI helpers — stays in each runtime. Only the closed sets,",
    "the per-action declarations and the laws live here."
  ],
  "not_this": [
    "Not the Director's actuator vocabulary (what globally scoped operation has an executor).",
    "Not the agent organ/world-action vocabulary (what a body can perceive from its locus).",
    "These three are related and are deliberately NOT flattened into one enum."
  ],

  "closed_sets": {
    "action_types": [
      "find_parts",
      "brush_field",
      "trace_direction",
      "connect_marks",
      "compose_percept",
      "assign_ground_role",
      "start_manuscript",
      "challenge_percept",
      "ask_model_reading"
    ],
    "targets": ["image", "ground", "percept", "manuscript", "operation"],
    "sources": ["user", "system", "model_suggested", "fixture", "user_confirmed"],
    "statuses": ["proposed", "previewed", "applied", "dismissed", "blocked"],
    "geometry_modes": ["soft_field", "polygon", "freehand", "vector", "curve", "unresolved"],
    "insertion_modes": ["staged", "unsaved"]
  },

  "source_notes": {
    "model_suggested": "so a suggestion can never be laundered into looking like the curator's own decision",
    "user_confirmed": "'I typed this' and 'I approved this' are different provenances"
  },

  "vocabularies": {
    "field_roles": [
      { "key": "light_field", "label": "Light field", "hint": "Where the light lives." },
      { "key": "shadow_field", "label": "Shadow field", "hint": "Where it is withheld." },
      { "key": "atmosphere_field", "label": "Atmosphere", "hint": "A condition, not an object." },
      { "key": "material_field", "label": "Material", "hint": "What the surface is made of." },
      { "key": "pressure_zone", "label": "Pressure", "hint": "Pushes on the reading without being its subject." },
      { "key": "gaze_field", "label": "Gaze field", "hint": "The region a look inhabits." },
      { "key": "negative_space", "label": "Negative space", "hint": "What is shaped by not being there." },
      { "key": "threshold", "label": "Threshold", "hint": "Where something becomes something else." },
      { "key": "fold", "label": "Fold", "hint": "Drapery, gathering, folded structure." },
      { "key": "rhythm", "label": "Rhythm", "hint": "One of several repeating things; the repetition is the point." },
      { "key": "background_recession", "label": "Recession", "hint": "What falls away behind." },
      { "key": "external_limit", "label": "External limit", "hint": "Where the frame stops settling the question." }
    ],
    "trace_roles": [
      { "key": "gaze_address", "label": "Gaze / address", "hint": "Where a look is directed." },
      { "key": "gesture", "label": "Gesture", "hint": "A body's directed movement." },
      { "key": "fall_of_light", "label": "Fall of light", "hint": "The direction light travels." },
      { "key": "architectural_axis", "label": "Architectural axis", "hint": "A structural line through the image." },
      { "key": "movement", "label": "Movement", "hint": "Implied motion." },
      { "key": "implied_address", "label": "Implied address", "hint": "Directed at the viewer, without a gaze." },
      { "key": "comparison_path", "label": "Comparison path", "hint": "Read this, then that." },
      { "key": "force_direction", "label": "Force", "hint": "Pressure with a direction." }
    ],
    "relation_roles": [
      { "key": "similarity", "label": "Similarity" },
      { "key": "contrast", "label": "Contrast" },
      { "key": "kinship", "label": "Kinship" },
      { "key": "motif_echo", "label": "Motif echo" },
      { "key": "support", "label": "Support" },
      { "key": "tension", "label": "Tension" },
      { "key": "contradiction", "label": "Contradiction" },
      { "key": "temporal_suggestion", "label": "Temporal suggestion" },
      { "key": "address_relation", "label": "Address relation" }
    ],
    "manuscript_modes": [
      { "key": "description", "label": "Description" },
      { "key": "art_critique", "label": "Critique" },
      { "key": "philosophical_note", "label": "Philosophical note" },
      { "key": "youtube_script", "label": "Script" },
      { "key": "research_note", "label": "Research note" },
      { "key": "caption", "label": "Caption" },
      { "key": "question_list", "label": "Questions" }
    ],
    "challenge_types": [
      { "key": "contradiction", "label": "Contradiction" },
      { "key": "missing_ground", "label": "Missing evidence" },
      { "key": "external_claim", "label": "External claim" },
      { "key": "overreach", "label": "Overreach" },
      { "key": "alternative_reading", "label": "Alternative reading" }
    ]
  },

  "target_labels": {
    "image": "Image marks",
    "ground": "Evidence relations",
    "percept": "Percepts",
    "manuscript": "Manuscript",
    "operation": "Operations & model questions"
  },

  "actions": {
    "find_parts": {
      "target": "operation",
      "required": [],
      "optional": ["way_of_looking", "vocabulary", "grain", "source_label", "reason"],
      "enums": {},
      "needs_geometry": false,
      "requires_confirmation": false,
      "why_no_confirmation": "deterministic, reversible by re-running"
    },
    "brush_field": {
      "target": "image",
      "required": ["field_role", "label"],
      "optional": ["target_hint", "geometry_mode", "color", "softness", "opacity", "requires_refinement", "reason"],
      "enums": { "field_role": "field_roles", "geometry_mode": "geometry_modes" },
      "needs_geometry": true,
      "requires_confirmation": true
    },
    "trace_direction": {
      "target": "image",
      "required": ["trace_role", "label"],
      "optional": ["from_hint", "to_hint", "geometry_mode", "requires_user_anchor", "reason"],
      "enums": { "trace_role": "trace_roles", "geometry_mode": "geometry_modes" },
      "needs_geometry": true,
      "requires_confirmation": true
    },
    "connect_marks": {
      "target": "ground",
      "required": ["relation_role"],
      "optional": ["source_refs", "target_refs", "label", "reason"],
      "enums": { "relation_role": "relation_roles" },
      "needs_geometry": true,
      "why_needs_geometry": "the curator picks which marks are connected",
      "requires_confirmation": true
    },
    "compose_percept": {
      "target": "percept",
      "required": ["draft_text"],
      "optional": [
        "intent", "ground_refs", "proposed_ground_refs", "action_refs",
        "suggested_ground_roles", "external_claim_warning", "reason"
      ],
      "enums": {},
      "needs_geometry": false,
      "requires_confirmation": true
    },
    "assign_ground_role": {
      "target": "percept",
      "required": ["ground_id", "role"],
      "optional": ["percept_id", "draft_percept_ref", "reason"],
      "enums": {},
      "why_no_enums": "roles are validated against groundRoles at the seam",
      "needs_geometry": false,
      "requires_confirmation": true
    },
    "start_manuscript": {
      "target": "manuscript",
      "required": ["mode"],
      "optional": ["draft", "cited_percept_refs", "action_refs", "insertion_mode", "reason"],
      "enums": { "mode": "manuscript_modes", "insertion_mode": "insertion_modes" },
      "needs_geometry": false,
      "requires_confirmation": true
    },
    "challenge_percept": {
      "target": "percept",
      "required": ["percept_ref", "challenge_type"],
      "optional": ["prompt", "reason"],
      "enums": { "challenge_type": "challenge_types" },
      "needs_geometry": false,
      "requires_confirmation": true
    },
    "ask_model_reading": {
      "target": "operation",
      "required": ["requested_reading_type"],
      "optional": ["model_family_hint", "packet_ref", "reason"],
      "enums": {},
      "needs_geometry": false,
      "requires_confirmation": true
    }
  },

  "default_labels": {
    "find_parts": { "literal": "Find parts" },
    "brush_field": { "prefix": "Brush ", "role_key": "field_role", "vocabulary": "field_roles", "fallback": "a field" },
    "trace_direction": { "prefix": "Trace ", "role_key": "trace_role", "vocabulary": "trace_roles", "fallback": "a direction" },
    "connect_marks": { "prefix": "Connect — ", "role_key": "relation_role", "vocabulary": "relation_roles", "fallback": "a relation" },
    "compose_percept": { "literal": "Compose a percept" },
    "assign_ground_role": { "literal": "Name what this ground does" },
    "start_manuscript": { "prefix": "Start a ", "role_key": "mode", "vocabulary": "manuscript_modes", "fallback": "passage" },
    "challenge_percept": { "literal": "Ask for a counter-reading" },
    "ask_model_reading": { "literal": "Ask the model to read this" }
  },
  "default_label_rule": "resolve the role key to its vocabulary label (or the raw key when unknown, or '' when absent), lowercase it, and use `fallback` when the result is empty. A label must never throw: an action with no role reaches validation and is REFUSED there, and a crash is not failing closed.",

  "laws": [
    {
      "id": "model-may-not-author-challenge",
      "kind": "error",
      "when": { "action": "challenge_percept", "source_in": ["model_suggested"] },
      "message": "challenge_percept may not be authored by a model",
      "why": "P1 addendum §3.1 — the human's veto over the circuit. The one rule here that is not about shape."
    },
    {
      "id": "nothing-is-dispatched",
      "kind": "error",
      "when": { "action": "ask_model_reading", "payload_path_is_true": "dispatch.sent" },
      "message": "ask_model_reading: dispatch.sent must be false — nothing is sent",
      "why": "Refused, not quietly corrected. A silently-reset dispatch flag is how a dispatch happens."
    },
    {
      "id": "insertion-mode-is-closed",
      "kind": "error",
      "when": { "action": "start_manuscript", "payload_key_outside_set": { "key": "insertion_mode", "set": "insertion_modes" } },
      "message": "start_manuscript: insertion_mode must be staged or unsaved"
    },
    {
      "id": "ask-model-reading-is-proposal-only",
      "kind": "warning",
      "when": { "action": "ask_model_reading" },
      "message": "Proposed only — no model call is made."
    },
    {
      "id": "manuscript-is-not-saved",
      "kind": "warning",
      "when": { "action": "start_manuscript" },
      "message": "Nothing is saved until you save it."
    },
    {
      "id": "percept-rests-on-an-external-claim",
      "kind": "warning",
      "when": { "action": "compose_percept", "payload_key_truthy": "external_claim_warning" },
      "message": "Rests on something the frame may not settle."
    },
    {
      "id": "geometry-is-the-curators-hand",
      "kind": "warning",
      "when": { "needs_geometry": true },
      "message": "Needs a mark from you on the image."
    }
  ],

  "messages": {
    "not_an_object": "not an object",
    "unknown_action_type": "unknown action type: {type}",
    "missing_id": "missing id",
    "missing_label": "missing label",
    "unknown_source": "unknown source: {value}",
    "unknown_status": "unknown status: {value}",
    "unknown_target": "unknown target: {value}",
    "target_mismatch": "target {value} does not match {type}",
    "created_at_not_a_number": "createdAt must be a number",
    "payload_required": "{type}: payload.{key} is required",
    "payload_not_in_vocabulary": "{type}: payload.{key} \"{value}\" is not in the vocabulary"
  },

  "never_applies": ["ask_model_reading"],
  "never_applies_why": "dispatch is not wired; an Apply that quietly does nothing teaches the curator that the panel is theatre",
  "model_forbidden_actions": ["challenge_percept"],

  "requires_confirmation_is_spec_authored": true,
  "requires_confirmation_why": "a proposal must not be able to declare itself confirmation-free and thereby skip the user"
}
