{
  "$defs": {
    "AlternativeInput": {
      "additionalProperties": false,
      "properties": {
        "alternative_id": {
          "default": "",
          "title": "Alternative Id",
          "type": "string"
        },
        "authorship": {
          "$ref": "#/$defs/Authorship"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "authorship"
      ],
      "title": "AlternativeInput",
      "type": "object"
    },
    "Authorship": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "kind": {
          "default": "human",
          "enum": [
            "human",
            "model"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_ref": {
          "default": "",
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "actor"
      ],
      "title": "Authorship",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "atom_refs": {
          "items": {
            "type": "string"
          },
          "title": "Atom Refs",
          "type": "array"
        },
        "claim_ref": {
          "title": "Claim Ref",
          "type": "string"
        },
        "image_refs": {
          "items": {
            "type": "string"
          },
          "title": "Image Refs",
          "type": "array"
        },
        "inference_refs": {
          "items": {
            "type": "string"
          },
          "title": "Inference Refs",
          "type": "array"
        },
        "reason": {
          "enum": [
            "source_atom_lineage",
            "immediate_graph_neighbour"
          ],
          "title": "Reason",
          "type": "string"
        },
        "source_unit_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Unit Refs",
          "type": "array"
        },
        "via_edge_refs": {
          "items": {
            "type": "string"
          },
          "title": "Via Edge Refs",
          "type": "array"
        }
      },
      "required": [
        "claim_ref",
        "reason"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "GraphPin": {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "title": "Checkpoint",
          "type": "integer"
        },
        "graph_hash": {
          "title": "Graph Hash",
          "type": "string"
        },
        "graph_id": {
          "title": "Graph Id",
          "type": "string"
        },
        "inquiry_id": {
          "title": "Inquiry Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "session_revision": {
          "title": "Session Revision",
          "type": "integer"
        }
      },
      "required": [
        "graph_id",
        "graph_hash",
        "schema_version",
        "inquiry_id",
        "session_revision",
        "checkpoint"
      ],
      "title": "GraphPin",
      "type": "object"
    },
    "Inspection": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "default": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "candidate_edge_refs": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Edge Refs",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "graph": {
          "$ref": "#/$defs/GraphPin"
        },
        "missing_links": {
          "items": {
            "type": "string"
          },
          "title": "Missing Links",
          "type": "array"
        },
        "narrowing_required": {
          "default": false,
          "title": "Narrowing Required",
          "type": "boolean"
        },
        "pilot_limit": {
          "const": 8,
          "default": 8,
          "title": "Pilot Limit",
          "type": "integer"
        },
        "producer": {
          "const": "semantic_constellation/lineage-v1",
          "default": "semantic_constellation/lineage-v1",
          "title": "Producer",
          "type": "string"
        },
        "source_unit_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Unit Refs",
          "type": "array"
        }
      },
      "required": [
        "graph"
      ],
      "title": "Inspection",
      "type": "object"
    },
    "PreservationJudgment": {
      "additionalProperties": false,
      "properties": {
        "assessed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed By"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "next_investigation": {
          "default": "",
          "maxLength": 4000,
          "title": "Next Investigation",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 4000,
          "title": "Note",
          "type": "string"
        },
        "recovered_thought": {
          "default": "",
          "maxLength": 4000,
          "title": "Recovered Thought",
          "type": "string"
        },
        "value": {
          "default": "not_assessed",
          "enum": [
            "not_assessed",
            "preserved",
            "partly_preserved",
            "lost",
            "unclear"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "title": "PreservationJudgment",
      "type": "object"
    },
    "SemanticConstellation": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/AlternativeInput"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "alternatives_exhaustive": {
          "const": false,
          "default": false,
          "title": "Alternatives Exhaustive",
          "type": "boolean"
        },
        "alternatives_mutually_exclusive": {
          "const": false,
          "default": false,
          "title": "Alternatives Mutually Exclusive",
          "type": "boolean"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "authorship": {
          "$ref": "#/$defs/Authorship"
        },
        "captured_checkpoint": {
          "title": "Captured Checkpoint",
          "type": "integer"
        },
        "central_tension": {
          "default": "",
          "title": "Central Tension",
          "type": "string"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed By"
        },
        "confirmed_claim_refs": {
          "items": {
            "type": "string"
          },
          "title": "Confirmed Claim Refs",
          "type": "array"
        },
        "confirmed_edge_refs": {
          "items": {
            "type": "string"
          },
          "title": "Confirmed Edge Refs",
          "type": "array"
        },
        "constellation_id": {
          "title": "Constellation Id",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "inquiry_id": {
          "default": "",
          "title": "Inquiry Id",
          "type": "string"
        },
        "inspection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inspection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "judgment": {
          "$ref": "#/$defs/PreservationJudgment"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "title": "Limits",
          "type": "array"
        },
        "membership_reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Membership Reviewed By"
        },
        "organising_question": {
          "title": "Organising Question",
          "type": "string"
        },
        "perceptual_questions": {
          "items": {
            "type": "string"
          },
          "title": "Perceptual Questions",
          "type": "array"
        },
        "perceptual_questions_executable": {
          "const": false,
          "default": false,
          "title": "Perceptual Questions Executable",
          "type": "boolean"
        },
        "perceptual_relevance": {
          "default": "",
          "title": "Perceptual Relevance",
          "type": "string"
        },
        "previous_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Revision"
        },
        "rejected_claim_refs": {
          "items": {
            "type": "string"
          },
          "title": "Rejected Claim Refs",
          "type": "array"
        },
        "rejected_edge_refs": {
          "items": {
            "type": "string"
          },
          "title": "Rejected Edge Refs",
          "type": "array"
        },
        "revised_at": {
          "title": "Revised At",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "revision_actor": {
          "title": "Revision Actor",
          "type": "string"
        },
        "revision_reason": {
          "enum": [
            "capture",
            "edit",
            "inspection",
            "human_review"
          ],
          "title": "Revision Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "semantic-constellation.v1",
          "default": "semantic-constellation.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "timing": {
          "enum": [
            "before_compilation",
            "retrospective"
          ],
          "title": "Timing",
          "type": "string"
        }
      },
      "required": [
        "constellation_id",
        "session_id",
        "revision",
        "created_at",
        "revised_at",
        "revision_actor",
        "revision_reason",
        "captured_checkpoint",
        "timing",
        "organising_question",
        "anchors",
        "authorship",
        "status"
      ],
      "title": "SemanticConstellation",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "enum": [
            "user",
            "scene_theorist"
          ],
          "title": "Author",
          "type": "string"
        },
        "exact_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "image_refs": {
          "items": {
            "type": "string"
          },
          "title": "Image Refs",
          "type": "array"
        },
        "origin": {
          "enum": [
            "user_prompt",
            "model_reading"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "span": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "source_id",
        "span",
        "exact_text",
        "source_sha256",
        "author"
      ],
      "title": "SourceAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "history": {
      "items": {
        "$ref": "#/$defs/SemanticConstellation"
      },
      "title": "History",
      "type": "array"
    },
    "preparation": {
      "default": "not_requested",
      "enum": [
        "prompt",
        "reading",
        "compiler",
        "released",
        "not_requested"
      ],
      "title": "Preparation",
      "type": "string"
    },
    "schema_version": {
      "const": "semantic-constellations.v1",
      "default": "semantic-constellations.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "SemanticConstellations",
  "type": "object"
}
